<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Vigilancia de competidores</title>
<style>
  :root{
    --bg:#f5f6f8; --panel:#ffffff; --ink:#14171c; --ink-2:#4a5260; --ink-3:#8a93a3;
    --line:#e3e6eb; --accent:#2f5bea; --accent-soft:#eaf0ff;
    --ok:#1f8a5b; --ok-soft:#e6f4ed; --warn:#b26a00; --warn-soft:#fff3e0;
    --radius:10px;
    --c-lanz:#2f5bea; --c-prec:#c2410c; --c-colab:#7c3aed; --c-equipo:#0f766e; --c-marca:#be185d; --c-comp:#4d7c0f;
  }
  @media (prefers-color-scheme: dark){
    :root{ --bg:#0f1115; --panel:#171a20; --ink:#eef0f3; --ink-2:#b4bbc7; --ink-3:#7c8595;
      --line:#262b34; --accent:#6b8cff; --accent-soft:#1c2440; --ok:#4cc38a; --ok-soft:#14261d;
      --warn:#f0a43a; --warn-soft:#2a2113; }
  }
  *{box-sizing:border-box}
  body{margin:0;font:14px/1.45 -apple-system,BlinkMacSystemFont,"Segoe UI",Inter,Roboto,sans-serif;background:var(--bg);color:var(--ink)}
  a{color:var(--accent);text-decoration:none} a:hover{text-decoration:underline}
  .wrap{max-width:1180px;margin:0 auto;padding:0 20px 48px}

  header{position:sticky;top:0;z-index:5;background:color-mix(in srgb,var(--bg) 88%,transparent);backdrop-filter:blur(8px);border-bottom:1px solid var(--line)}
  .bar{max-width:1180px;margin:0 auto;padding:14px 20px;display:flex;gap:16px;align-items:center;flex-wrap:wrap}
  h1{font-size:17px;margin:0;font-weight:650;letter-spacing:-.01em}
  .meta{color:var(--ink-3);font-size:12.5px}
  .spacer{flex:1}
  select,button{font:inherit;font-size:13px;color:var(--ink);background:var(--panel);border:1px solid var(--line);border-radius:8px;padding:6px 10px;cursor:pointer}
  button:hover,select:hover{border-color:var(--ink-3)}

  .notice{margin:16px 0 0;padding:10px 14px;border-radius:var(--radius);font-size:13px}
  .notice.warn{background:var(--warn-soft);color:var(--warn)}
  .notice.info{background:var(--accent-soft);color:var(--accent)}

  /* Resumen */
  .summary{display:grid;grid-template-columns:200px 1fr;gap:12px;margin-top:20px}
  .kpi{background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);padding:16px}
  .kpi .lbl{font-size:11.5px;text-transform:uppercase;letter-spacing:.06em;color:var(--ink-3)}
  .kpi .num{font-size:34px;font-weight:700;letter-spacing:-.02em;margin-top:4px;font-variant-numeric:tabular-nums}
  .kpi .sub{font-size:12.5px;color:var(--ink-2);margin-top:2px}
  .tiles{display:grid;grid-template-columns:repeat(6,1fr);gap:12px}
  .tile{background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);padding:12px 14px;display:flex;flex-direction:column;gap:6px;cursor:pointer;transition:border-color .15s}
  .tile:hover{border-color:var(--accent)}
  .tile .h{font-size:12.5px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .tile .n{font-size:24px;font-weight:700;font-variant-numeric:tabular-nums}
  .tile .bar2{height:4px;border-radius:2px;background:var(--line);overflow:hidden}
  .tile .bar2 i{display:block;height:100%;background:var(--accent)}
  .tile.zero .n{color:var(--ink-3)}
  .tile .st{font-size:11.5px;color:var(--ink-3)}

  /* Filtros */
  .filters{display:flex;gap:6px;flex-wrap:wrap;margin:22px 0 4px}
  .chip{font-size:12px;padding:4px 10px;border-radius:999px;border:1px solid var(--line);background:var(--panel);color:var(--ink-2);cursor:pointer;user-select:none}
  .chip.on{background:var(--ink);color:var(--panel);border-color:var(--ink)}

  /* Competidores */
  section.comp{margin-top:18px;background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);overflow:hidden}
  .comp-h{display:flex;align-items:center;gap:10px;padding:12px 16px;border-bottom:1px solid var(--line)}
  .avatar{width:30px;height:30px;border-radius:50%;background:var(--accent-soft);color:var(--accent);display:grid;place-items:center;font-weight:700;font-size:13px;flex:none}
  .comp-h h2{font-size:14.5px;margin:0;font-weight:650}
  .count{font-size:12px;padding:2px 8px;border-radius:999px;background:var(--accent-soft);color:var(--accent);font-weight:600}
  .count.none{background:var(--ok-soft);color:var(--ok)}
  .comp-h .ig{margin-left:auto;font-size:12.5px}
  .empty{padding:14px 16px;color:var(--ink-3);font-size:13px;display:flex;align-items:center;gap:8px}
  .empty .dot{width:8px;height:8px;border-radius:50%;background:var(--ok)}

  .cards{display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:12px;padding:14px 16px 16px}
  .card{border:1px solid var(--line);border-left:3px solid var(--cat,var(--accent));border-radius:8px;padding:12px 14px;display:flex;flex-direction:column;gap:8px;background:var(--panel)}
  .card .top{display:flex;align-items:center;gap:8px;font-size:12px;color:var(--ink-3)}
  .cat{font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.05em;color:var(--cat)}
  .card .what{font-weight:600;font-size:14px;line-height:1.4}
  .impact{background:var(--bg);border-radius:6px;padding:8px 10px;font-size:13px;color:var(--ink-2)}
  .impact b{display:block;font-size:11px;text-transform:uppercase;letter-spacing:.05em;color:var(--ink-3);margin-bottom:2px;font-weight:600}
  .src{font-size:12.5px;display:flex;gap:6px;align-items:center;color:var(--ink-3)}
  .src a{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .demo-tag{font-size:10.5px;font-weight:700;color:var(--warn);background:var(--warn-soft);padding:1px 6px;border-radius:4px;margin-left:auto}

  @media (max-width:900px){
    .summary{grid-template-columns:1fr}
    .tiles{grid-template-columns:repeat(3,1fr)}
  }
  @media (max-width:520px){ .tiles{grid-template-columns:repeat(2,1fr)} .cards{grid-template-columns:1fr} }
</style>
</head>
<body>

<header>
  <div class="bar">
    <h1>Vigilancia de competidores</h1>
    <span class="meta" id="lastUpdate"></span>
    <span class="spacer"></span>
    <select id="weekSel" aria-label="Semana"></select>
    <button id="demoBtn" type="button">Ver con datos de ejemplo</button>
  </div>
</header>

<main class="wrap">
  <div id="notices"></div>

  <div class="summary">
    <div class="kpi">
      <div class="lbl">Movimientos esta semana</div>
      <div class="num" id="kTotal">0</div>
      <div class="sub" id="kSub"></div>
    </div>
    <div class="tiles" id="tiles"></div>
  </div>

  <div class="filters" id="filters"></div>
  <div id="list"></div>
</main>

<script>
/* =====================================================================
   DATOS — la tarea semanal añade una semana nueva al principio de "weeks"
   y actualiza "lastUpdated". Formato de cada movimiento:
   { competitor, date:"AAAA-MM-DD", category, what, source:{label,url}, impact }
   category: lanzamiento | precio | colaboracion | equipo | marca | competicion
   webOnly: true si esa semana no se pudo revisar Instagram
   ===================================================================== */
const DATA = {
  lastUpdated: null,
  competitors: ["betoherraiz18","rubencastro26","romeroliftsx","nikolaos.fit","marcmonterox","pedroperezfit"],
  weeks: []
};

/* Datos ficticios solo para ver el diseño. No son movimientos reales. */
const DEMO = {
  lastUpdated: "2026-11-09T18:47:00",
  competitors: DATA.competitors,
  weeks: [
    { start:"2026-11-02", end:"2026-11-08", webOnly:false, moves:[
      { competitor:"betoherraiz18", date:"2026-11-04", category:"precio",
        what:"Ejemplo: baja la asesoría mensual y lanza un descuento por Black Friday.",
        source:{label:"Post de Instagram", url:"#"},
        impact:"Ejemplo: fija un precio de referencia más bajo en el mercado; revisa si tu oferta necesita respuesta o un argumento de valor." },
      { competitor:"betoherraiz18", date:"2026-11-06", category:"colaboracion",
        what:"Ejemplo: código de descuento con una marca de suplementos.",
        source:{label:"Story (vista el 06/11)", url:"#"},
        impact:"Ejemplo: esa marca trabaja con perfiles de tu tamaño; candidata para contactar." },
      { competitor:"romeroliftsx", date:"2026-11-03", category:"lanzamiento",
        what:"Ejemplo: abre un programa de 12 semanas de preparación para competir en powerlifting.",
        source:{label:"Web / enlace de la bio", url:"#"},
        impact:"Ejemplo: entra directo en tu nicho; diferenciarte con tu experiencia compitiendo." },
      { competitor:"marcmonterox", date:"2026-11-07", category:"equipo",
        what:"Ejemplo: incorpora a un nutricionista al equipo de asesorías.",
        source:{label:"Post de Instagram", url:"#"},
        impact:"Ejemplo: refuerza la parte de dieta, que es tu punto fuerte; compárate en ese servicio." }
    ]},
    { start:"2026-10-26", end:"2026-11-01", webOnly:true, moves:[
      { competitor:"nikolaos.fit", date:"2026-10-29", category:"marca",
        what:"Ejemplo: cambia la bio y se enfoca en hipertrofia para mujeres.",
        source:{label:"Perfil de Instagram", url:"#"},
        impact:"Ejemplo: deja de competir por tu público general; menos presión en hombres principiantes." }
    ]}
  ]
};

const CATS = {
  lanzamiento:{label:"Lanzamiento", color:"var(--c-lanz)"},
  precio:{label:"Precio / oferta", color:"var(--c-prec)"},
  colaboracion:{label:"Colaboración", color:"var(--c-colab)"},
  equipo:{label:"Equipo", color:"var(--c-equipo)"},
  marca:{label:"Marca / posicionamiento", color:"var(--c-marca)"},
  competicion:{label:"Competición / logro", color:"var(--c-comp)"}
};

let demo = false, weekIdx = 0, activeCat = null;
const $ = id => document.getElementById(id);
const esc = s => String(s ?? "").replace(/[&<>"']/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
const fmtDate = d => { if(!d) return "—"; const x = new Date(d.length===10 ? d+"T12:00:00" : d);
  return x.toLocaleDateString("es-ES",{day:"2-digit",month:"short"}); };
const fmtFull = d => new Date(d).toLocaleString("es-ES",{day:"2-digit",month:"short",year:"numeric",hour:"2-digit",minute:"2-digit"});
const src = () => demo ? DEMO : DATA;

function render(){
  const D = src(), week = D.weeks[weekIdx];
  const moves = week ? week.moves : [];

  $("lastUpdate").textContent = D.lastUpdated ? "Última actualización: " + fmtFull(D.lastUpdated) : "Pendiente de la primera ejecución";
  $("demoBtn").textContent = demo ? "Volver a datos reales" : "Ver con datos de ejemplo";

  // Selector de semana
  $("weekSel").innerHTML = D.weeks.length
    ? D.weeks.map((w,i)=>`<option value="${i}" ${i===weekIdx?"selected":""}>Semana ${fmtDate(w.start)} – ${fmtDate(w.end)}</option>`).join("")
    : `<option>Sin semanas registradas</option>`;
  $("weekSel").disabled = !D.weeks.length;

  // Avisos
  let n = "";
  if(demo) n += `<div class="notice warn">Estás viendo datos de ejemplo inventados para revisar el diseño. No son movimientos reales.</div>`;
  else if(!D.weeks.length) n += `<div class="notice info">Todavía no hay informes. Se rellenará con la primera ejecución de la vigilancia semanal.</div>`;
  if(week && week.webOnly) n += `<div class="notice warn">Esta semana no se pudo revisar Instagram: datos solo de búsqueda web.</div>`;
  $("notices").innerHTML = n;

  // KPI y fichas resumen
  const per = Object.fromEntries(D.competitors.map(c=>[c, moves.filter(m=>m.competitor===c).length]));
  const max = Math.max(1, ...Object.values(per));
  const withNews = Object.values(per).filter(v=>v>0).length;
  $("kTotal").textContent = moves.length;
  $("kSub").textContent = `${withNews} de ${D.competitors.length} competidores con novedades`;
  $("tiles").innerHTML = D.competitors.map(c=>`
    <div class="tile ${per[c]?"":"zero"}" data-go="${esc(c)}" title="Ir a ${esc(c)}">
      <div class="h">@${esc(c)}</div>
      <div class="n">${per[c]}</div>
      <div class="bar2"><i style="width:${per[c]/max*100}%"></i></div>
      <div class="st">${per[c] ? (per[c]===1?"1 movimiento":per[c]+" movimientos") : "Sin novedades"}</div>
    </div>`).join("");

  // Filtros por categoría
  const usedCats = [...new Set(moves.map(m=>m.category))];
  if(activeCat && !usedCats.includes(activeCat)) activeCat = null;
  $("filters").innerHTML = usedCats.length ? [`<span class="chip ${!activeCat?"on":""}" data-cat="">Todas</span>`]
    .concat(usedCats.map(k=>`<span class="chip ${activeCat===k?"on":""}" data-cat="${k}">${esc(CATS[k]?.label||k)}</span>`)).join("") : "";

  // Lista por competidor (siempre los 6)
  $("list").innerHTML = D.competitors.map(c=>{
    const all = moves.filter(m=>m.competitor===c).sort((a,b)=>b.date.localeCompare(a.date));
    const list = activeCat ? all.filter(m=>m.category===activeCat) : all;
    const body = !all.length
      ? `<div class="empty"><span class="dot"></span>Sin novedades esta semana</div>`
      : !list.length
        ? `<div class="empty">Sin movimientos de esta categoría (${all.length} en total)</div>`
        : `<div class="cards">${list.map(card).join("")}</div>`;
    return `<section class="comp" id="c-${esc(c)}">
      <div class="comp-h">
        <div class="avatar">${esc(c[0].toUpperCase())}</div>
        <h2>@${esc(c)}</h2>
        <span class="count ${all.length?"":"none"}">${all.length ? all.length : "Sin novedades"}</span>
        <a class="ig" href="https://www.instagram.com/${encodeURIComponent(c)}/" target="_blank" rel="noopener">Ver perfil ↗</a>
      </div>${body}</section>`;
  }).join("");
}

function card(m){
  const cat = CATS[m.category] || {label:m.category||"Otro", color:"var(--accent)"};
  const url = m.source?.url, label = m.source?.label || url || "—";
  return `<article class="card" style="--cat:${cat.color}">
    <div class="top"><span class="cat">${esc(cat.label)}</span><span>· ${fmtDate(m.date)}</span>${demo?'<span class="demo-tag">EJEMPLO</span>':""}</div>
    <div class="what">${esc(m.what)}</div>
    <div class="impact"><b>Qué significa para nosotros</b>${esc(m.impact)}</div>
    <div class="src">Fuente: ${url && url!=="#" ? `<a href="${esc(url)}" target="_blank" rel="noopener">${esc(label)}</a>` : esc(label)}</div>
  </article>`;
}

$("weekSel").addEventListener("change", e=>{ weekIdx = +e.target.value; render(); });
$("demoBtn").addEventListener("click", ()=>{ demo = !demo; weekIdx = 0; activeCat = null; render(); });
$("filters").addEventListener("click", e=>{ const c = e.target.closest(".chip"); if(!c) return; activeCat = c.dataset.cat || null; render(); });
$("tiles").addEventListener("click", e=>{ const t = e.target.closest(".tile"); if(!t) return;
  document.getElementById("c-"+t.dataset.go)?.scrollIntoView({behavior:"smooth", block:"start"}); });

render();
</script>
</body>
</html>
